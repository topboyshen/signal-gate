# Default deny: only the reviewed source, documentation, units and offline test
# below belong in this repository. Add new source paths deliberately.
/*
!/.gitignore
!/README.md
!/run-tests.sh
!/app/
/app/*
!/app/server.py
!/app/review_bot.py
!/app/review_outbox.py
!/app/research_contract.py
!/app/digest.py
!/app/input_status.py
!/app/digest_content.py
!/app/news_history.py
!/app/research_receipts.py
!/app/selftest.py
!/app/review_selftest.py
!/app/e2e_forward_check.py
!/docs/
/docs/*
!/docs/NGINX_PROXY.md
!/docs/REVIEW.md
!/systemd/
/systemd/*
!/systemd/signal-gate.service
!/systemd/signal-gate-review.service
!/systemd/signal-gate-digest.service
!/systemd/signal-gate-digest.timer
!/systemd/project-portal-inputs.service
!/tests/
/tests/*
!/tests/test_offline.py
!/tests/test_digest_content.py
!/tests/test_news_history.py
!/tests/test_digest_delivery.py
!/tests/test_sealed_research.py
!/tests/test_research_receipts.py
!/tests/test_research_receiver.py
!/tests/test_input_status.py
!/tests/test_review_outbox.py
!/tests/test_research_contract.py

# Defense in depth for runtime material, including nested copies.
**/*.env
**/.env*
**/*public_url.txt
**/nginx_path_token.txt
**/data/
**/out/
**/inbox/
**/__pycache__/
**/*.py[cod]
**/*.db
**/*.db-*
**/*.sqlite*
**/*.log
**/.venv/
**/venv/
